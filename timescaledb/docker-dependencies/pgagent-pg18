ARG ALPINE_VERSION=3.24
FROM alpine:${ALPINE_VERSION}
ARG VERSION
ARG TARGETARCH
ARG TARGETVARIANT
ARG PG_MAJOR=18

# --------------------------------------------
# pgAgent - build patched version and install
# --------------------------------------------
RUN mkdir -p /build
COPY timescaledb/pgagent.patch /build/

# CMake finds PostgreSQL through the pg_config of this PostgreSQL version in the PATH
# hadolint ignore=DL3018,DL3003
RUN --mount=type=cache,id=apk-${TARGETARCH}-${TARGETVARIANT},sharing=locked,target=/var/cache/apk \
    set -ex \
    && apk update \
    && apk add \
        boost-dev \
        build-base \
        ca-certificates \
        cmake \
        git \
        openldap-dev \
        postgresql${PG_MAJOR} \
        postgresql${PG_MAJOR}-dev \
    && CLANG_VERSION="$(sed -n 's/^CLANG = clang-//p' "/usr/lib/postgresql${PG_MAJOR}/pgxs/src/Makefile.global")" \
    && apk add "clang${CLANG_VERSION}" "llvm${CLANG_VERSION}" \
    && git clone https://github.com/postgres/pgagent /build/pgagent \
    && cd /build/pgagent \
    && git checkout "${VERSION}" \
    && git apply -v ../pgagent.patch \
    && export PATH="/usr/libexec/postgresql${PG_MAJOR}:${PATH}" \
    && cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 . \
    && make -j"$(nproc)" \
    && make install \
    && cd / \
    && rm -rf /build

LABEL \
    org.opencontainers.image.source="https://github.com/expaso/hassos-addon-timescaledb"
