#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: TimescaleDb
# Initializes the container during startup
# ==============================================================================
declare POSTGRES_DATA
declare VERSION_FILE
declare NEW_INSTALL
declare BUILD_TIMESTAMP
declare RESTORE_MODE

POSTGRES_DATA=/data/postgres
VERSION_FILE=/data/version
NEW_INSTALL=false
RESTORE_MODE=false
BUILD_TIMESTAMP="$(cat /build-timestamp)"

# Restore functions, and backupAvailable to detect a database dump from a backup
# shellcheck source=/dev/null
source /usr/share/timescaledb/restore_from_backup.sh

# Returns success when extension $2 is installed in database $1.
# Compares the query result instead of piping to 'grep -q': under bashio's pipefail,
# grep closing the pipe early can make an installed extension look missing.
extensionInstalled () {
	[[ "$(psql -X -U postgres -d "${1}" -tAc "select 1 from pg_extension where extname = '${2}';")" == "1" ]]
}

# Applies permission to the data directory for the postgres user
applyPermissions () {
	chown -R postgres:postgres ${POSTGRES_DATA}
	chmod 700 ${POSTGRES_DATA}
}

# Initializes the data directory
# $1: Optional extra arguments for initdb
# $2: Optional password authentication method for pg_hba.conf (default: scram-sha-256)
initializeDataDirectory () {
	local INITDB_ARGS=${1:-}
	local AUTH_METHOD=${2:-scram-sha-256}
	# Init data-directory
    bashio::log.info "Initializing new postgres directory.."
	mkdir -p ${POSTGRES_DATA}
	applyPermissions
	su - postgres -c "initdb ${INITDB_ARGS} -D ${POSTGRES_DATA}"
	# Set timescaledb and pg_stat_statements as being enabled in the postgres config file.
	sed -r -i "s/[#]*\s*(shared_preload_libraries)\s*=\s*'(.*)'/\1 = 'timescaledb,pg_stat_statements,\2'/;s/,'''/'/;s/,'/'/" ${POSTGRES_DATA}/postgresql.conf
	
	# Set Password protect IPv4 hosts by default
	{
		echo "host    all             all             0.0.0.0/0               ${AUTH_METHOD}"
		# Set Password protect IPv6 hosts by default
		echo "host    all             all             ::/0                    ${AUTH_METHOD}"
		echo "local    all             all                                    ${AUTH_METHOD}"
		echo "local    all             all                                   peer"
	} >> "${POSTGRES_DATA}/pg_hba.conf"
	# Set Listen on all addresses (*)
	sed -r -i "s/[#]listen_addresses.=.'.*'/listen_addresses\ \=\ \'\*\'/g" ${POSTGRES_DATA}/postgresql.conf

	echo "timescaledb.license_key='CommunityLicense'" >> ${POSTGRES_DATA}/postgresql.conf
	if bashio::config.has_value 'timescaledb.telemetry'; then
		# Set telemetry level
		echo "timescaledb.telemetry_level=$(bashio::config 'timescaledb.telemetry')" >> ${POSTGRES_DATA}/postgresql.conf
	fi
	bashio::log.info "done"
}

# Upgrades the timescale extensions on all databases.
upgradeTimeScaleExtension () {
	# Upgrade Timescale..
	bashio::log.info "Upgrading Timescale extentions.."
	bashio::log.info "Updating Timescale Extension for system databases.."

	# Fetch all databases..
	psql \
		-X \
		-U "postgres" \
		-c "select datname from pg_database where datallowconn = true;" \
		--set ON_ERROR_STOP=off \
		--no-align \
		-t \
		--field-separator ' ' \
		--quiet \
	| while read -r datname; do
		extensionInstalled "${datname}" timescaledb \
		&& (
			bashio::log.info "Try updating Timescale Extension for database: '${datname}'.."; \
			# Drop timescaledb-extras helpers that block the update, see the script for details.
			# Please note that we do not drop the extension itself, because that would drop the hypertables as well.
			psql -X -U "postgres" -d "${datname}" -f /usr/share/timescaledb/drop_timescaledb_extras.sql; \
			(psql -X -U postgres -d "${datname}" -c "ALTER EXTENSION timescaledb UPDATE;" || true)
		)

		# Update Timescale Toolkit Extension when needed
		extensionInstalled "${datname}" timescaledb_toolkit \
		&& (
			bashio::log.info "Try updating Timescale Toolkit Extension for database: '${datname}'.."; \
			(psql -X -U postgres -d "${datname}" -c "ALTER EXTENSION timescaledb_toolkit UPDATE;" || true)
		)

		# Update Vector extension when needed
		extensionInstalled "${datname}" vector \
		&& (
			bashio::log.info "Try updating Vector Extension for database: '${datname}'.."; \
			(psql -X -U postgres -d "${datname}" -c "ALTER EXTENSION vector UPDATE;" || true)
		)

	done

	bashio::log.info "done"
}

# Upgrades the PostgreSQL databases
# $1: The current version
# $2: The new version
upgradePostgreSQL() {
	local FROM_VERSION=${1}
	local TO_VERSION=${2}

	bashio::log.notice "Upgrading databases now. This could take a while. Please be patient..."

	# Move the old data directory out of our way..
	mv "${POSTGRES_DATA}" "${POSTGRES_DATA}${FROM_VERSION}"

	# And upgrade PostgreSQL
	bashio::log.notice "Upgrading PostgreSql from ${FROM_VERSION} to ${TO_VERSION}.."

	# Backup old HBA.conf and create a temp one...
	mv "${POSTGRES_DATA}${FROM_VERSION}/pg_hba.conf" "${POSTGRES_DATA}${FROM_VERSION}/pg_hba_backup.conf"
	echo "local    all             all                                     trust" > "${POSTGRES_DATA}${FROM_VERSION}/pg_hba.conf"

	#Start postgres on the old data-dir
	bashio::log.info "Starting PostgreSQL-${FROM_VERSION} first.."
	su - postgres -c "/usr/libexec/postgresql${FROM_VERSION}/postgres -D ${POSTGRES_DATA}${FROM_VERSION}" &
	postgres_pid=$!

	# Wait for postgres to become available..
	while ! psql -X -U "postgres" postgres -c "" 2> /dev/null; do
		sleep 1
	done

	# Upgrade Timescale first, otherwise, pg_upgrade will fail.
	upgradeTimeScaleExtension

	# Stop server
	bashio::log.notice "Stopping PostgreSql ${FROM_VERSION}.."
	kill ${postgres_pid}
	wait ${postgres_pid} || true
	bashio::log.notice "done"

	# Restore HBA.CONF
	rm "${POSTGRES_DATA}${FROM_VERSION}/pg_hba.conf"
	mv "${POSTGRES_DATA}${FROM_VERSION}/pg_hba_backup.conf" "${POSTGRES_DATA}${FROM_VERSION}/pg_hba.conf"

	# Create a fresh data-directory.
	# PostgreSQL 18 enables data checksums by default, but pg_upgrade requires the new cluster
	# to use the same setting as the old one.
	local INITDB_ARGS=""
	local OLD_CONTROLDATA
	OLD_CONTROLDATA="$("/usr/libexec/postgresql${FROM_VERSION}/pg_controldata" "${POSTGRES_DATA}${FROM_VERSION}")"
	if [[ "${OLD_CONTROLDATA}" =~ Data\ page\ checksum\ version:[[:space:]]*0($'\n'|$) ]]; then
		INITDB_ARGS="--no-data-checksums"
	fi
	# Keep md5 for an upgraded cluster: its roles may still have MD5 password hashes, which
	# scram-sha-256 rejects, while md5 accepts both MD5 and SCRAM hashes.
	initializeDataDirectory "${INITDB_ARGS}" "md5"

	# And upgrade!
	bashio::log.notice "Upgrading databases.."
	cd "${POSTGRES_DATA}${FROM_VERSION}" || return 1
	if su -c "pg_upgrade --old-bindir=/usr/libexec/postgresql${FROM_VERSION} --new-bindir=/usr/libexec/postgresql${TO_VERSION} --old-datadir=${POSTGRES_DATA}${FROM_VERSION} --new-datadir=${POSTGRES_DATA} --link --username=postgres" -s /bin/sh postgres; then
		bashio::log.notice "PostgreSQL upgraded succesfully!"
		# Remove the old cluster...
		rm -r "${POSTGRES_DATA}${FROM_VERSION}"
		return 0
	else
		# copy logs
		cp -r /data/postgres/pg_upgrade_output.d "${POSTGRES_DATA}${FROM_VERSION}" || true

		# Rollback..
		rm -r ${POSTGRES_DATA}
		mv "${POSTGRES_DATA}${FROM_VERSION}" "${POSTGRES_DATA}"

		bashio::log.error "PostgreSQL could not upgrade! Please inspect any errors in the lines above!"
		return 1
	fi
}

# Prepare /tmp/pg_stat_tmp directory
mkdir -p /tmp/pg_stat_tmp
chown postgres:postgres /tmp/pg_stat_tmp

if ! bashio::fs.directory_exists "${POSTGRES_DATA}"; then
    bashio::log.info "Detected a fresh installation! Welcome! We're setting things up for you.."
    NEW_INSTALL=true
    
    # Check if we have a backup to restore from
    if backupAvailable; then
        bashio::log.notice "Found a database dump from a backup. Will restore after initialization."
        RESTORE_MODE=true
    fi
else
    touch ${VERSION_FILE}
	# Always re-apply permissions, because they seem to be reset after a snapshot restore
	applyPermissions

	# Check if PG_VERSION exists – if it is absent the data directory is empty or corrupted
	if [[ ! -f "${POSTGRES_DATA}/PG_VERSION" ]]; then
	    NEW_INSTALL=true
	    # Move the invalid/empty directory aside so we can start fresh
	    if [[ -d "${POSTGRES_DATA}" ]]; then
	        bashio::log.info "Moving invalid database directory aside..."
	        mv "${POSTGRES_DATA}" "${POSTGRES_DATA}.corrupted.$(date +%Y%m%d_%H%M%S)"
	    fi
	    # If a SQL backup is available, restore from it; otherwise start fresh
	    if backupAvailable; then
	        bashio::log.warning "Database appears corrupted (missing PG_VERSION). Database dump from a backup found."
	        bashio::log.warning "Will attempt to restore from backup..."
	        RESTORE_MODE=true
	    else
	        bashio::log.warning "Database directory exists but is not initialized (missing PG_VERSION)."
	        bashio::log.warning "No backup available. Initializing a fresh database..."
	    fi
	fi
fi

# Initialize for new installs
if bashio::var.true "${NEW_INSTALL}"; then
	touch /data/firstrun
	echo "${BUILD_TIMESTAMP}" > ${VERSION_FILE}
	# New installations use scram-sha-256 (PostgreSQL 18 deprecates MD5 passwords). A restore
	# keeps md5: the restored roles may still have MD5 password hashes.
	if bashio::var.true "${RESTORE_MODE}"; then
		initializeDataDirectory "" "md5"
	else
		initializeDataDirectory
	fi
	
	# Restore from backup if available
	if bashio::var.true "${RESTORE_MODE}"; then
	    bashio::log.notice "Restore mode enabled."
	    if restoreFromBackup; then
	        bashio::log.notice "Database restored successfully from the backup!"
	        # Mark that we've restored, so postgres startup can skip firstrun setup
	        rm -f /data/firstrun
	    else
	        bashio::log.error "Failed to restore from backup. Starting with fresh database."
	        bashio::log.error "The database dump has been preserved in /data/backup (or /data/backup_db.sql)"
	        bashio::log.error "You may attempt manual restoration if needed."
	        # Keep the backup file for manual recovery
	    fi
	fi
else

	# Check if we need to restore again.
	if bashio::config.true 'retry_upgrade'; then
		if bashio::fs.directory_exists "${POSTGRES_DATA}17"; then
			bashio::log.notice "An aborted upgrade from Postgres 17 was detected. Restoring.."
			rm -r ${POSTGRES_DATA}
			mv ${POSTGRES_DATA}17 ${POSTGRES_DATA}
		else
			bashio::config.suggest.false 'retry_upgrade' 'This option is only for temporary reasons: to recover from a failed upgrade.'
		fi
	fi

	# Check if we need to upgrade from 12 to 15
	if [[ $(< ${POSTGRES_DATA}/PG_VERSION) == "12" ]]; then
		bashio::log.notice "A database upgrade is required from Postgres 12."
		bashio::log.error "Upgrade was not succesfull. This addon version does no longer support Postgres 12. Please upgrade to the previous version of the addon and upgrade to Postgres 14 first." 
		exit 1
	fi

	# Check if we need to upgrade from 14 to 15
	if [[ $(< ${POSTGRES_DATA}/PG_VERSION) == "14" ]]; then
		bashio::log.notice "A database upgrade is required from Postgres 14."
		bashio::log.error "Upgrade was not succesfull. This addon version does no longer support Postgres 14. Please upgrade to the previous version of the addon and upgrade to Postgres 15 first." 
		exit 1
	fi

	# Postgres 15 and 16 need the previous add-on version (5.x) to upgrade to 17 first
	for OLD_VERSION in 15 16; do
		if [[ $(< ${POSTGRES_DATA}/PG_VERSION) == "${OLD_VERSION}" ]]; then
			bashio::log.notice "A database upgrade is required from Postgres ${OLD_VERSION}."
			bashio::log.error "Upgrade was not succesfull. This addon version does no longer support Postgres ${OLD_VERSION}. Please install addon version 5.x first to upgrade to Postgres 17, then update to this version."
			exit 1
		fi
	done

	# Check if we need to upgrade from 17 to 18
	if [[ $(< ${POSTGRES_DATA}/PG_VERSION) == "17" ]]; then
		bashio::log.notice "A database upgrade is required from Postgres 17 -> 18"
		if upgradePostgreSQL 17 18; then
			bashio::log.notice "Upgrade was succesful"
		else
			bashio::log.error "Upgrade was not succesful."
			exit 1
		fi
	fi
fi

bashio::log.info "done"


# Ensure pg_stat_statements is in shared_preload_libraries for existing installations
if bashio::var.false "${NEW_INSTALL}"; then
	if ! grep -q "shared_preload_libraries.*pg_stat_statements" ${POSTGRES_DATA}/postgresql.conf; then
		bashio::log.info "Adding pg_stat_statements to shared_preload_libraries.."
		sed -r -i "s/(shared_preload_libraries\s*=\s*'[^']*)(timescaledb)([^']*')/\1\2,pg_stat_statements\3/" ${POSTGRES_DATA}/postgresql.conf
		bashio::log.info "done"
	fi
fi

# Load VectorChord (vchord, needed by Immich) at startup when the vectorchord option is on,
# and stop loading it when it is off. The other libraries are left as they are.
configureVectorChord() {
	local conf="${POSTGRES_DATA}/postgresql.conf"
	local current
	local wanted=""
	local lib
	local -a libs

	current="$(sed -n -E "s/^shared_preload_libraries\s*=\s*'([^']*)'.*/\1/p" "${conf}" | tail -n 1)"
	IFS=',' read -r -a libs <<< "${current}"
	for lib in "${libs[@]}"; do
		lib="${lib// /}"
		if [[ -n "${lib}" ]] && [[ "${lib}" != "vchord" ]] && [[ "${lib}" != "vchord.so" ]]; then
			wanted="${wanted:+${wanted},}${lib}"
		fi
	done
	if bashio::config.true 'vectorchord'; then
		wanted="${wanted:+${wanted},}vchord"
	fi

	if [[ "${wanted}" != "${current}" ]]; then
		bashio::log.info "Setting shared_preload_libraries to '${wanted}'.."
		sed -i -E "s/^(shared_preload_libraries\s*=\s*)'[^']*'/\1'${wanted}'/" "${conf}"
	fi
}
configureVectorChord

# Patch telemetry level
if bashio::config.has_value 'timescaledb.telemetry'; then
	sed -r -i "s/timescaledb.telemetry_level.=.'.*'/timescaledb.telemetry_level=$(bashio::config 'timescaledb.telemetry')/g" ${POSTGRES_DATA}/postgresql.conf
fi
if bashio::config.has_value 'timescaledb.maxmemory'; then
	# Apply TimescaleDb mem/cpu tuning settings
	bashio::log.info "Tuning resources.."

	chmod 707 "/usr/share/timescaledb/002_timescaledb_tune.sh"
	TS_TUNE_MEMORY=$(bashio::config 'timescaledb.maxmemory') \
		TS_TUNE_NUM_CPUS=$(bashio::config 'timescaledb.maxcpus') \
		POSTGRESQL_CONF_DIR=${POSTGRES_DATA} \
		/usr/share/timescaledb/002_timescaledb_tune.sh
	bashio::log.info "done"
fi

# Appy max connections
if bashio::config.has_value 'max_connections'; then
	bashio::log.info "Applying max connections.."
	sed -i -e "/max_connections =/ s/= .*/= $(bashio::config 'max_connections')/" ${POSTGRES_DATA}/postgresql.conf
	bashio::log.info "done"
fi

# Always invoke the user-config script: even when both override blocks are
# empty it still cleans up any previously written user-defined pg_hba.conf
# rules so a cleared config is honored.
bashio::log.info "Applying user configuration overrides.."
chmod 707 "/usr/share/timescaledb/003_apply_user_config.sh"
/usr/share/timescaledb/003_apply_user_config.sh
bashio::log.info "done"
