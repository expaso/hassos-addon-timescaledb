ARG ALPINE_VERSION=3.24
FROM alpine:${ALPINE_VERSION}
ARG VERSION
ARG TARGETARCH
ARG TARGETVARIANT
ARG PG_MAJOR=18
SHELL ["/bin/ash", "-o", "pipefail", "-c"]

# -----------------------------------------------------------------
# TimescaleDB Toolkit (Rust/pgrx), built against the PostgreSQL package of this Alpine release
# -----------------------------------------------------------------
# hadolint ignore=DL3018,SC3014
RUN --mount=type=cache,id=apk-${TARGETARCH}-${TARGETVARIANT},sharing=locked,target=/var/cache/apk \
    --mount=type=cache,id=cargo-${TARGETARCH}-${TARGETVARIANT},sharing=locked,target=/root/.cargo \
    set -ex \
    && apk update \
    && apk add \
        build-base \
        ca-certificates \
        clang \
        clang-libclang \
        curl \
        git \
        openssl-dev \
        pkgconf \
        postgresql${PG_MAJOR} \
        postgresql${PG_MAJOR}-dev \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain stable \
    && export PATH="/root/.cargo/bin:${PATH}" \
    && export OPENSSL_DIR=/usr \
    && cargo install --version '=0.18.1' --locked --force cargo-pgrx

ENV RUST_MIN_STACK=4194304

# Docker tags cannot contain '+': a VERSION like 1.27.0-p2 builds git tag 1.27.0+p2
# hadolint ignore=DL3003,SC3014
RUN --mount=type=cache,id=pgrx-${TARGETARCH}-${TARGETVARIANT},sharing=locked,target=/root/.pgrx \
    --mount=type=cache,id=cargo-${TARGETARCH}-${TARGETVARIANT},sharing=locked,target=/root/.cargo \
    set -ex \
    && export PATH="/root/.cargo/bin:${PATH}" \
    && export RUSTFLAGS="-C target-feature=-crt-static -C codegen-units=1" \
    && PG_CONFIG="/usr/libexec/postgresql${PG_MAJOR}/pg_config" \
    && mkdir -p /build /root/.pgrx \
    && cd /build \
    && git clone https://github.com/timescale/timescaledb-toolkit.git . \
    && git checkout "$(echo "${VERSION}" | sed "s/-p\([0-9]*\)$/+p\1/")" \
    && cd extension \
    && printf '[configs]\npg%s="%s"\n' "${PG_MAJOR}" "${PG_CONFIG}" > /root/.pgrx/config.toml \
    && cargo pgrx install --release --pg-config "${PG_CONFIG}" \
    && cargo run --manifest-path ../tools/post-install/Cargo.toml -- "${PG_CONFIG}" \
    && cd / \
    && rm -rf /build

LABEL \
    org.opencontainers.image.source="https://github.com/expaso/hassos-addon-timescaledb"
