#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# pgAgent is an auxiliary service: when it stops, only pgAgent is restarted by
# S6 and PostgreSQL keeps running. It never takes down the container.
# ==============================================================================
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service="pgagent"

# Stopped by S6 itself (container shutdown or service restart): nothing to do
if [[ "${exit_code_service}" -eq 256 ]]; then
  exit 0
fi

if [[ "${exit_code_service}" -ne 0 ]]; then
  bashio::log.warning \
    "Service ${service} exited with code ${exit_code_service}" \
    "(by signal ${exit_code_signal}), restarting ${service} only.."
  # Throttle restarts (S6 allows a finish script 5 seconds)
  sleep 3
fi
